# Copy to .env next to docker-compose.yml and adjust.

# Bearer token required by the control API. Leave empty for no auth
# (only sane on a trusted LAN).
UDPBENCH_API_TOKEN=change-me

# Port the control API listens on. Host networking means this competes
# with everything else on the box; if the container exits with "port
# already in use", find a free one (`sudo ss -tlnp | grep <port>`).
API_PORT=5390
