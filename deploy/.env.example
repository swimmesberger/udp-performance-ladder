# Copy to .env next to docker-compose.yml and adjust.

# The forwarder's listen endpoint on the device under test (required).
TARGET=192.168.178.126:5000

# UDP payload bytes, minimum 8 (the sequence number).
SIZE=32

# Offered load in packets per second; 0 = unthrottled.
RATE=250000

# Sender runtime in seconds.
SEND_DURATION=30

# Sink port (the forwarder's --to must point here) and runtime; keep the
# sink running longer than the sender so it catches the tail.
SINK_PORT=6000
SINK_DURATION=40
